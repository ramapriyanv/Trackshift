# TrackShift environment configuration
# Copy to .env.local and fill in your Spotify app credentials.
#
# Spotify Developer Dashboard (https://developer.spotify.com/dashboard):
#   1. Open your app -> Settings.
#   2. Add this EXACT redirect URI (Spotify rejects "localhost" for new apps):
#        http://127.0.0.1:3000/api/auth/callback/spotify
#   3. Copy the Client ID and Client Secret below.
#
# Always open the app at http://127.0.0.1:3000 (not localhost:3000).

AUTH_SPOTIFY_ID=your-spotify-client-id
AUTH_SPOTIFY_SECRET=your-spotify-client-secret

# Generate with: npx auth secret   (or any random 32+ byte base64 string)
AUTH_SECRET=

# Leave AUTH_URL unset for local development.
# On Vercel, set it to the stable production HTTPS origin, for example:
# AUTH_URL=https://your-project.vercel.app
# Register this exact production callback in the Spotify dashboard:
# https://your-project.vercel.app/api/auth/callback/spotify
# Keep the local callback registered too if you still develop locally.
